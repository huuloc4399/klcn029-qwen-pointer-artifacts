# Personal CVs and generated corpora
CV_EN_PDF/
CV_VN_PDF/
corpus_v2/
annotation/data/
annotation_app/data/
gold_review_app/data/
gold_review_app/dist/
gold_review_app/.venv/
baseline_extraction/data/tmp*/
baseline_extraction/data/
baseline_extraction/outputs/
training/data/
training/audits/
training/evaluation/results/

# Secrets and local runtime state
*.key
.secrets/
.apikey
.hftoken
.env
.env.*
!.env.example
cv_evaluation_web/data/*
!cv_evaluation_web/data/.gitignore
# Satisfaction ratings copied from the API host contain free-text comments.
feedback*.jsonl
feedback*.xlsx

# Large model artifacts and generated results
training/*.zip
training/colab/*.zip
# Colab upload bundles may hold real CV text (e.g. GOLD40 inputs); only the synthetic
# GGUF fidelity bundle is safe to version.
training/colab/artifacts/*
!training/colab/artifacts/gguf_fidelity_bundle_v1.zip
dist/
experiments/ocr/model_cache/
experiments/ocr/.venv/
*.safetensors
*.pth

# Python/editor state
__pycache__/
*.py[cod]
.pytest_cache/
.idea/
.vscode/
tmp/

# Human ratings of CV-JD pairs quote real CVs; downstream run outputs
downstream/data/labels_v1/
# Original postings as copied from job sites; only the team rewrite is versioned
downstream/data/jd_v1/raw/
downstream/results/
