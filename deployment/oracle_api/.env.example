# Copy to .env on the VM (cp .env.example .env && nano .env). Never commit or paste .env.

# Public hostname Caddy serves over HTTPS. Without a domain: <public-ip-with-dashes>.sslip.io
API_DOMAIN=

# Random key shared with Render (EXTRACTION_API_KEY). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must NOT be a Hugging Face token.
API_KEY=

# Fine-grained Hugging Face token, read-only on the private artifact repo (downloads the GGUF).
HF_TOKEN=

# GGUF exported by training/colab/Qwen3_Pointer_GGUF_Export_Colab.ipynb (cell 7 output).
GGUF_REPO_ID=huuloc4399/klcn029-qwen-pointer-artifacts
GGUF_FILENAME=gguf/qwen3-4b-pointer-stage2-q4_k_m.gguf
GGUF_REVISION=
GGUF_SHA256=ba7ad3faf0132c92ee995c10a147a44eb3036a34e4a8d186d670e31fdac7c45a

# 1 = PDF images are OCR'd (PaddleOCR / VietOCR); 0 = text PDFs only (smaller, faster build).
WITH_OCR=1

# Optional overrides
# LLAMA_THREADS=2
# MAX_PENDING_JOBS=8
# JOB_TTL_SECONDS=3600
