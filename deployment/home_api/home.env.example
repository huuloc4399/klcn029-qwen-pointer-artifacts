# Copied to <Root>\home.env by setup_home.ps1. Fill it in there; never commit or paste it.

# Random key shared with Render (EXTRACTION_API_KEY). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must NOT be a Hugging Face token.
API_KEY=

# Fine-grained Hugging Face token, read-only on the private artifact repo (downloads the GGUF).
HF_TOKEN=

# GGUF exported by training/colab/Qwen3_Pointer_GGUF_Export_Colab.ipynb on 2026-10-12.
GGUF_REPO_ID=huuloc4399/klcn029-qwen-pointer-artifacts
GGUF_FILENAME=gguf/qwen3-4b-pointer-stage2-q4_k_m.gguf
GGUF_REVISION=3b4b9af7a83bac6f822678813fc2f0756bcd23e6
GGUF_SHA256=ba7ad3faf0132c92ee995c10a147a44eb3036a34e4a8d186d670e31fdac7c45a

# Model layers placed on the GPU. GTX 1650 4 GB: 28 leaves room for the 6144-token KV cache.
# If llama-server fails with an out-of-memory error, lower it (24, 20...). 0 = CPU only.
N_GPU_LAYERS=28

# Local port of llama-server (127.0.0.1 only). Change it if another program uses it.
LLAMA_PORT=8091

# Seconds per CV used for queue ETAs until real jobs finish. Replace with
# seconds_mean_after_first from the fidelity check (start_home.ps1 -Fidelity).
JOB_SECONDS_ESTIMATE=120

# RAG strategy (M3) of the web: bge-m3 embeddings from a second llama-server on the CPU.
# The first start downloads 0.6 GB (pinned, hash-checked). EMBED_ENABLED=0 skips it; the web
# then falls back to keyword retrieval.
EMBED_ENABLED=1
EMBED_PORT=8093

# Optional
# MAX_PENDING_JOBS=8
# JOB_TTL_SECONDS=3600
