# Copy to .env on the VPS (cp .env.example .env && nano .env). Never commit, paste or send .env.

# Public hostname Caddy serves over HTTPS. Without a domain: <public-ip-with-dashes>.sslip.io
DOMAIN=

# Random keys. Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
CV_WEB_SECRET_KEY=
# Key for /admin (satisfaction ratings), at least 16 characters; leave empty to disable the page.
CV_WEB_ADMIN_KEY=

# Groq key for the rubric strategies M1–M4 and P; empty = rule-based scoring only.
GROQ_API_KEY=

# Fine-grained Hugging Face token, read-only on the private artifact repo (downloads the GGUF).
HF_TOKEN=

# GGUF exported by training/colab/Qwen3_Pointer_GGUF_Export_Colab.ipynb (same as the Oracle/home setup).
GGUF_REPO_ID=huuloc4399/klcn029-qwen-pointer-artifacts
GGUF_FILENAME=gguf/qwen3-4b-pointer-stage2-q4_k_m.gguf
GGUF_REVISION=3b4b9af7a83bac6f822678813fc2f0756bcd23e6
GGUF_SHA256=ba7ad3faf0132c92ee995c10a147a44eb3036a34e4a8d186d670e31fdac7c45a

# 1 = PDF images are OCR'd (PaddleOCR / VietOCR); 0 = text PDFs only (smaller, less RAM).
WITH_OCR=1
# Threads for llama.cpp: the number of vCPUs of the VPS.
LLAMA_THREADS=2

# Optional
# CV_WEB_RESEARCH_ENABLED=0     # 1 keeps consented CVs on the VPS for research
# CV_WEB_RATE_LIMIT_PER_HOUR=10
# MAX_PENDING_JOBS=8
# JOB_SECONDS_ESTIMATE=180
